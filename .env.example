# Layer 2 runtime LLM (owner decision 2026-09-15). Never hardcoded.
ATSC_DEEP_LLM_MODEL=claude-sonnet-5
# Only the Layer 2 worker process gets this. The web process must not.
# ANTHROPIC_API_KEY=

# Layer 2 retrieval embedding model (self-hosted, ONNX). See docs/build_plan.md Phase 8.
ATSC_DEEP_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
