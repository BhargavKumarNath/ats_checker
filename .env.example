# Layer 2 runtime LLM (owner decision 2026-09-15). Never hardcoded.
ATSC_DEEP_LLM_MODEL=claude-sonnet-5
# Only the Layer 2 worker process gets this. The web process must not.
# ANTHROPIC_API_KEY=

# Free-layer rate limit on POST /score, per client, sliding window (Phase 12). 0 disables.
ATSC_SCORE_RATE_LIMIT=30
ATSC_SCORE_RATE_WINDOW_SECONDS=600
# Only behind a trusted proxy: header carrying the real client IP (Fly: Fly-Client-IP).
ATSC_CLIENT_IP_HEADER=

# Layer 2 retrieval embedding model (self-hosted, ONNX). See docs/build_plan.md Phase 8.
ATSC_DEEP_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Layer 2 persistence and delivery (Phase 10). Postgres in production, SQLite locally.
ATSC_DATABASE_URL=sqlite:///./atsc.db
ATSC_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Stripe Checkout, one-time price. All three required for the paid path to be offered.
ATSC_STRIPE_SECRET_KEY=
ATSC_STRIPE_PRICE_ID=
ATSC_STRIPE_WEBHOOK_SECRET=
# Report link email; leave the host empty to log links instead of sending.
ATSC_SMTP_HOST=
ATSC_SMTP_PORT=587
ATSC_SMTP_USER=
ATSC_SMTP_PASSWORD=
ATSC_EMAIL_FROM=
